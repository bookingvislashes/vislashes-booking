# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin Migrations page (/admin/migrations) — runs supabase/migrations/*.sql
# for you instead of pasting them into the Supabase SQL Editor by hand.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# (the one with the password already filled in, not the read-only pooler).
# Optional: everything else in the app works without it.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Square
SQUARE_ACCESS_TOKEN=EAAAl...
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-...
NEXT_PUBLIC_SQUARE_LOCATION_ID=L...
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=bookings@vislashes.com

# Google Calendar (Settings → Google Calendar)
# New bookings are added to the connected calendar; cancelling one removes it.
#
# In the Google Cloud console: create a project, enable the Google Calendar
# API, then create an OAuth 2.0 Client ID of type "Web application". Its
# Authorised redirect URI must be exactly <NEXT_PUBLIC_BASE_URL>/api/google/callback
# — https://www.vislashes.com/api/google/callback in production. Add
# http://localhost:3000/api/google/callback too if you develop locally.
#
# While the OAuth consent screen is in Testing, add the salon's Google account
# under Test users or the connection is refused, and Google expires the refresh
# token after seven days. Publishing the app stops that expiry.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin push notifications (Settings → Notifications)
# Generate a real pair with: npx web-push generate-vapid-keys
# The public key is safe to expose; the private key is a secret and must
# never be committed or given the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vislashes.com
