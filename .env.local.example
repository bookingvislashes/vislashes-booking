# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Square
SQUARE_ACCESS_TOKEN=EAAAl...
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-...
NEXT_PUBLIC_SQUARE_LOCATION_ID=L...
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=bookings@vislashes.com

# Google Calendar sync was planned but never built — there is no
# /api/calendar-sync route and no code reads any GOOGLE_* variable. Do not try
# to configure it; the credentials would do nothing.

# Web Push (admin "new booking" notifications). Generate a pair with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT must be a mailto: or
# https: URL — push services use it to contact you if your server misbehaves.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:owner@example.com

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
